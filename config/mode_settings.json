{
    "general": {
        "ignore_referenced": true,
        "ignore_nodes": ["persp", "top", "front", "side"]
    },
    "naming": {
        "group": {
            "prefix": "",
            "suffix": "_grp",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "geo": {
            "prefix": "",
            "suffix": "_geo",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "curve": {
            "prefix": "",
            "suffix": "_crv",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "shape": {
            "template": "{transform}Shape",
            "shape_types": ["mesh", "nurbsCurve", "nurbsSurface"]
        },
        "strip_suffixes": ["_grp", "_group", "_geo", "_mesh", "_msh", "_crv", "_curve"]
    },
    "mesh": {
        "max_face_sides": 4,
        "zero_area_tolerance": 1e-08,
        "zero_length_tolerance": 1e-06,
        "transform_tolerance": 1e-05,
        "history_ignore_types": ["groupId", "shadingEngine", "objectSet", "displayLayer"]
    },
    "uv": {
        "max_uv_sets": 1,
        "default_uv_set": "map1",
        "allow_udim": true,
        "udim_max_u": 10
    },
    "material": {
        "default_shading_group": "initialShadingGroup",
        "default_material_policy": "required"
    },
    "color": {
        "allow_color_sets": false
    },
    "checks": {
        "naming_group": true,
        "naming_geo": true,
        "naming_curve": true,
        "naming_shape": true,
        "duplicate_names": true,
        "empty_groups": true,
        "mesh_ngons": true,
        "mesh_non_manifold": true,
        "mesh_lamina": true,
        "mesh_zero_area": true,
        "mesh_zero_length": true,
        "mesh_history": true,
        "mesh_unfrozen": true,
        "mesh_locked_normals": true,
        "uv_missing": true,
        "uv_sets": true,
        "uv_set_name": true,
        "uv_range": true,
        "uv_cross_border": true,
        "uv_flipped": true,
        "uv_overlap": true,
        "mat_missing": true,
        "mat_policy": true,
        "mat_per_face": true,
        "color_sets": true,
        "color_display": true,
        "color_outliner": true
    }
}
