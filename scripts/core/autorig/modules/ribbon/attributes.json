{
    "extends": "base",
    "module_label": "Ribbon",
    "sections": {
        "Ribbon": {
            "order": 25
        },
        "Shape": {"remove": true},
        "Space Switch": {"remove": true}
    },
    "attributes": {
        "shapeCtrl": {"remove": true},
        "shapeTranslate": {"remove": true},
        "shapeRotate": {"remove": true},
        "shapeScale": {"remove": true},
        "aimVector": {
            "tooltip": "Axe des joints et ctrls du ruban aligné sur la longueur de la surface (tangente de la Ribbon Direction)."
        },
        "upVector": {
            "tooltip": "Axe des joints et ctrls du ruban aligné sur la normale de la surface."
        },
        "spaceSwitchTargets": {"remove": true},

        "bindJointCount": {
            "label": "Bind Joint Count",
            "widget": "int",
            "order": 80,
            "section": "Ribbon",
            "min": 2,
            "max": 40,
            "tooltip": "Nombre de joints de skin répartis le long du ruban (follicules).",
            "at": "long",
            "value": 9
        },
        "ribbonWidth": {
            "label": "Ribbon Width",
            "widget": "float",
            "order": 84,
            "section": "Ribbon",
            "min": 0.01,
            "tooltip": "Largeur du ruban (le long de l'up vector).",
            "at": "double",
            "value": 2.0
        },
        "ribbonSurface": {
            "label": "Ribbon Surface",
            "widget": "message",
            "accept": "nurbsSurface",
            "order": 86,
            "section": "Ribbon",
            "tooltip": "Surface NURBS existante à utiliser pour le ruban. Vide = surface créée au build à partir des guides.",
            "at": "message"
        },
        "ribbonJointGuides": {
            "label": "Joint Guides",
            "widget": "message_list",
            "accept": "guide",
            "order": 88,
            "section": "Ribbon",
            "tooltip": "Guides qui correspondent aux joints du ruban, dans l'ordre. Vide = guides du module.",
            "at": "message",
            "multi": true
        },
        "ribbonDirection": {
            "label": "Ribbon Direction",
            "widget": "enum",
            "order": 89,
            "section": "Ribbon",
            "tooltip": "Direction de la longueur du ruban sur la NURBS (follicules, joints et ctrls répartis le long de celle-ci). Auto : la plus longue de U et V, mesurée sur la surface.",
            "at": "enum",
            "enumName": "Auto:U:V",
            "value": 1
        },
        "ribbonOffsetDirection": {
            "label": "Offset Direction",
            "widget": "enum",
            "order": 89.1,
            "section": "Ribbon",
            "tooltip": "Axe de décalage des deux curves qui forment le ruban construit sur les guides. Z : normale au plan de la chaîne (ruban à plat dans ce plan). Y : vers le 2e guide (ruban perpendiculaire au plan).",
            "at": "enum",
            "enumName": "Y:Z",
            "value": 1
        },
        "ribbonReverse": {
            "label": "Reverse Offset",
            "widget": "bool",
            "order": 89.2,
            "section": "Ribbon",
            "tooltip": "Décale les curves dans le sens opposé : les deux bords sont échangés et la normale du ruban est inversée (le sens de sa longueur ne change pas).",
            "at": "bool",
            "value": 0
        },
        "ribbonPinch": {
            "label": "Pinch",
            "widget": "float",
            "order": 89.3,
            "section": "Ribbon",
            "min": 0.0,
            "max": 0.25,
            "decimals": 3,
            "step": 0.005,
            "tooltip": "Pincement de la main nurb seulement : des knots sont insérés à +/- cette valeur autour de chaque isoparm d'origine (un par guide). Plus petit = pli plus serré. 0 = pas de pincement.",
            "at": "double",
            "value": 0.01
        },
        "ribbonDegree": {
            "label": "Degree",
            "widget": "enum",
            "order": 89.35,
            "section": "Ribbon",
            "tooltip": "Degré des nurbs des niveaux, dans leur longueur (la main nurb construite est en degré 3). Auto : selon le nombre de ctrls du niveau (2 -> 1, 3 -> 2, 4-5 -> 3, 6-7 -> 5, 8+ -> 7).",
            "at": "enum",
            "enumName": "Auto:1:2:3:5:7",
            "value": 2
        },
        "ribbonUniformIsoparms": {
            "label": "Uniform Isoparms",
            "widget": "bool",
            "order": 89.4,
            "section": "Ribbon",
            "tooltip": "Coché : isoparms du ruban construit sur les guides répartis uniformément (loft uniforme). Décoché : espacement selon les curves (un isoparm à chaque guide).",
            "at": "bool",
            "value": 0
        },
        "follicleScale": {
            "label": "Follicle Scale",
            "widget": "bool",
            "order": 89.5,
            "section": "Ribbon",
            "tooltip": "Connecte le scale monde du joint root au scale des follicules (et donc des sk joints). Avec le stretch actif, les follicules s'étirent aussi le long du ruban.",
            "at": "bool",
            "value": 1
        },
        "ribbonStretch": {
            "label": "Ribbon Stretch",
            "widget": "bool",
            "order": 89.6,
            "section": "Ribbon",
            "visible_when": {"attr": "follicleScale", "equals": 1},
            "tooltip": "Stretch des follicules : chacun s'étire le long du ruban selon l'étirement local de la surface (tangente / longueur au repos, à l'échelle du rig).",
            "at": "bool",
            "value": 0
        },
        "levelCount": {
            "label": "Level Count",
            "widget": "int",
            "order": 90,
            "section": "Ribbon",
            "min": 1,
            "max": 5,
            "tooltip": "Nombre de niveaux de déformation du ruban. Chaque niveau a ses propres ctrls, réglés dans sa section 'Level N'.",
            "at": "long",
            "value": 1
        },

        "level1ControlCount": {
            "label": "Control Count",
            "widget": "int",
            "order": 110,
            "section": "Level 1",
            "visible_when": {"attr": "levelCount", "min": 1},
            "min": 2,
            "max": 20,
            "tooltip": "Nombre de ctrls du niveau 1.",
            "at": "long",
            "value": 3
