{
    "extends": "simpleFk",
    "module_label": "Spine Ribbon",
    "sections": {
        "FK": {
            "order": 22,
            "collapsed": true
        },
        "Ribbon": {
            "order": 25,
            "collapsed": true
        },
        "Level 1": {"order": 26, "collapsed": true},
        "Level 2": {"order": 27, "collapsed": true},
        "Level 3": {"order": 28, "collapsed": true}
    },
    "attributes": {
        "noCtrl": {
            "hidden": true
        },
        "shapeCtrl": {
            "hidden": true
        },
        "shapeTranslate": {
            "label": "FK Shape Translate"
        },
        "shapeRotate": {
            "label": "FK Shape Rotate"
        },
        "shapeScale": {
            "label": "FK Shape Scale"
        },
        "spaceSwitchTargets": {
            "tooltip": "Guides ajoutés ici : espaces du space switch du premier ctrl FK."
        },

        "fkShape": {
            "label": "FK Shape",
            "widget": "enum",
            "order": 60,
            "section": "FK",
            "tooltip": "Forme des ctrls FK (un par guide, chaînés).",
            "at": "enum",
            "enumName": "circle:square:cube:sphere:diamond:arrow:plus:pyramid",
            "value": 0
        },
        "fkSize": {
            "label": "FK Size",
            "widget": "float",
            "order": 62,
            "section": "FK",
            "min": 0.01,
            "tooltip": "Taille des ctrls FK.",
            "at": "double",
            "value": 1.5
        },

        "bindJointCount": {
            "label": "Bind Joint Count",
            "widget": "int",
            "order": 80,
            "section": "Ribbon",
            "min": 2,
            "max": 40,
            "tooltip": "Nombre de joints de skin répartis le long du ruban (follicules).",
            "at": "long",
            "value": 9
        },
        "ribbonWidth": {
            "label": "Ribbon Width",
            "widget": "float",
            "order": 84,
            "section": "Ribbon",
            "min": 0.01,
            "tooltip": "Largeur du ruban (le long de l'up vector).",
            "at": "double",
            "value": 2.0
        },
        "ribbonDirection": {
            "label": "Ribbon Direction",
            "widget": "enum",
            "order": 89,
            "section": "Ribbon",
            "tooltip": "Direction de la longueur du ruban sur la NURBS. Auto : la plus longue de U et V.",
            "at": "enum",
            "enumName": "Auto:U:V",
            "value": 1
        },
        "ribbonPinch": {
            "label": "Pinch",
            "widget": "float",
            "order": 89.3,
            "section": "Ribbon",
            "min": 0.0,
            "max": 0.25,
            "decimals": 3,
            "step": 0.005,
            "tooltip": "Pincement de la main nurb seulement : des knots sont insérés à +/- cette valeur autour de chaque isoparm d'origine (un par guide). Plus petit = pli plus serré. 0 = pas de pincement.",
            "at": "double",
            "value": 0.01
        },
        "ribbonDegree": {
            "label": "Degree",
            "widget": "enum",
            "order": 89.35,
            "section": "Ribbon",
            "tooltip": "Degré des nurbs des niveaux, dans leur longueur (la main nurb construite est en degré 3). Auto : selon le nombre de ctrls du niveau (2 -> 1, 3 -> 2, 4-5 -> 3, 6-7 -> 5, 8+ -> 7).",
            "at": "enum",
            "enumName": "Auto:1:2:3:5:7",
            "value": 0
        },
        "ribbonUniformIsoparms": {
            "label": "Uniform Isoparms",
            "widget": "bool",
            "order": 89.4,
            "section": "Ribbon",
            "tooltip": "Coché : isoparms du ruban répartis uniformément (loft uniforme). Décoché : espacement selon les curves (un isoparm à chaque guide).",
            "at": "bool",
            "value": 0
        },
        "follicleScale": {
            "label": "Follicle Scale",
            "widget": "bool",
            "order": 89.5,
            "section": "Ribbon",
            "tooltip": "Connecte le scale monde du joint root au scale des follicules (et donc des sk joints). Avec le stretch actif, les follicules s'étirent aussi le long du ruban.",
            "at": "bool",
            "value": 1
        },
        "ribbonStretch": {
            "label": "Ribbon Stretch",
            "widget": "bool",
            "order": 89.6,
            "section": "Ribbon",
            "visible_when": {"attr": "follicleScale", "equals": 1},
            "tooltip": "Stretch des follicules : chacun s'étire le long du ruban selon l'étirement local de la surface (tangente / longueur au repos, à l'échelle du rig).",
            "at": "bool",
            "value": 0
        },
        "levelCount": {
            "label": "Level Count",
            "widget": "int",
            "order": 90,
            "section": "Ribbon",
            "min": 0,
            "max": 3,
            "tooltip": "Nombre de niveaux de ctrls du ruban (0 = ruban piloté par la chaîne FK seulement, 3 max). Chaque niveau a ses ctrls, réglés dans sa section 'Level N'.",
            "at": "long",
            "value": 1
        },

        "level1ControlCount": {
            "label": "Control Count",
            "widget": "int",
            "order": 110,
            "section": "Level 1",
            "visible_when": {"attr": "levelCount", "min": 1},
            "min": 2,
            "max": 20,
            "tooltip": "Nombre de ctrls du niveau 1.",
